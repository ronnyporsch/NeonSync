<?xml version="1.0" encoding="utf-8"?>
<!-- neonsync.svg (64x64) centred in the 108dp adaptive icon, inside its 66dp safe zone -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="22"
        android:translateY="22">
        <!-- SVG: translate(32 32) rotate(-32) scale(0.86) translate(-30 -31) -->
        <group
            android:pivotX="30"
            android:pivotY="31"
            android:rotation="-32"
            android:scaleX="0.86"
            android:scaleY="0.86"
            android:translateX="2"
            android:translateY="1">
            <!-- Beam and the pool of light it casts -->
            <path android:pathData="M20,14 L40,14 L56,54 A26,7 0 0,1 4,54 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="linear"
                        android:startX="0"
                        android:startY="14"
                        android:endX="0"
                        android:endY="60">
                        <item android:offset="0" android:color="#FFFF2FD6" />
                        <item android:offset="0.5" android:color="#CC8A5CFF" />
                        <item android:offset="1" android:color="#7322E5FF" />
                    </gradient>
                </aapt:attr>
            </path>
            <path
                android:fillAlpha="0.75"
                android:fillColor="#22E5FF"
                android:pathData="M4,54 A26,7 0 1,0 56,54 A26,7 0 1,0 4,54 Z" />
            <!-- Lamp head with bright lens -->
            <path android:pathData="M24,-1 L36,-1 A10,10 0 0,1 36,19 L24,19 A10,10 0 0,1 24,-1 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="linear"
                        android:startX="16"
                        android:startY="0"
                        android:endX="44"
                        android:endY="16">
                        <item android:offset="0" android:color="#FFFF2FD6" />
                        <item android:offset="1" android:color="#FF8A5CFF" />
                    </gradient>
                </aapt:attr>
            </path>
            <path
                android:fillAlpha="0.95"
                android:fillColor="#FFFFFF"
                android:pathData="M22.5,12 L37.5,12 A2.5,2.5 0 0,1 37.5,17 L22.5,17 A2.5,2.5 0 0,1 22.5,12 Z" />
        </group>
    </group>
</vector>
